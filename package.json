{
  "name": "liaison",
  "productName": "Liaison",
  "version": "1.5.6",
  "description": "Main courante du tronc principal : liaison entre les services matin, après-midi et nuit",
  "main": "src/main.js",
  "author": "Aethilia",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win --x64 --publish never",
    "dist:dir": "electron-builder --dir"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "fr.aethilia.liaison",
    "productName": "Liaison",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Liaison",
      "artifactName": "Liaison-Installation-${version}.exe"
    },
    "directories": {
      "output": "dist"
    },
    "portable": {
      "artifactName": "Liaison-Portable-${version}.exe"
    }
  }
}
